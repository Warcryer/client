{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Warcryer",
  "version": "0.41.0",
  "identifier": "org.warcryer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Warcryer",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required --use-fake-ui-for-media-stream",
        "dragDropEnabled": false
      },
      {
        "label": "strip",
        "create": false,
        "title": "Warcryer strip",
        "url": "index.html",
        "width": 340,
        "height": 34,
        "resizable": true,
        "transparent": true,
        "shadow": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required --use-fake-ui-for-media-stream",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https://app.warcryer.org https://ignite.v1rtopia.com",
        "font-src": "'self' data:",
        "media-src": "'self' blob: mediastream:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https://app.warcryer.org wss://app.warcryer.org https://rtc.warcryer.org wss://rtc.warcryer.org https://ignite.v1rtopia.com wss://ignite.v1rtopia.com https://ignite-rtc.v1rtopia.com wss://ignite-rtc.v1rtopia.com",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/uninstall.ico"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "warcryer"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxQkJBNEY5NTMxNkRGNEYKUldSUDN4WlQrYVM3VWZ0M2hZZ2JpNDdhajVzSDVmUnZSRDdBTTVrSFExWit1TFBWME9ReTZadnQK",
      "endpoints": [
        "https://app.warcryer.org/api/app/update?v={{current_version}}&target={{target}}&arch={{arch}}",
        "https://ignite.v1rtopia.com/api/app/update?v={{current_version}}&target={{target}}&arch={{arch}}",
        "https://github.com/Warcryer/client/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
